# Copie ce fichier en ".env" (sans .example) et renseigne ta propre clé.
# Ce fichier ".env" est ignoré par git (voir .gitignore) — chaque machine garde
# la sienne, jamais commitée.
#
# Analyse IA des rapports (api_report_analysis.php) — fournisseur par défaut :
# Anthropic. Renseigne au moins une des deux clés ci-dessous ; les deux si tu
# veux pouvoir basculer entre fournisseurs (paramètre "provider" de l'API).

# Clé API Anthropic (https://console.anthropic.com/settings/keys), utilisée par
# class/AnthropicClient.php — fournisseur par défaut.
ANTHROPIC_API_KEY=

# Clé API Gemini (https://aistudio.google.com/apikey), utilisée par
# class/GeminiClient.php — fournisseur alternatif ("provider": "gemini").
GEMINI_API_KEY=

# Notifications push OneSignal (class/OneSignalNotifier.php) — une notification
# est envoyée à chaque synchronisation (api_brvm_sync.php / cron_sync_brvm.php).
# App ID et clé REST API : Réglages OneSignal > Keys & IDs de ton app.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# URL publique de ce backend, utilisée pour le lien "voir le tableau complet"
# dans la notification (market-movers.php). En local (MAMP), le lien ne sera
# ouvrable que depuis cette machine — mets ici ton vrai domaine une fois hébergé.
APP_BASE_URL=http://localhost/BRVM_Insights/Backend/brvm-api
