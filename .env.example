# Variables lues par docker-compose.yml (pas par l'app PHP directement — le
# conteneur backend les reçoit via `environment:` dans docker-compose.yml).
#
# Usage : cp .env.example .env, renseigne les valeurs, puis
#   docker compose up -d --build
# Ce ".env" (racine du dépôt) est un fichier différent de
# Backend/brvm-api/.env (utilisé hors Docker, par un MAMP local) — inutile
# de les synchroniser.

# --- Base de données ---
DB_ROOT_PASSWORD=changeme-root
DB_USER=brvm
DB_PASSWORD=changeme-brvm

# --- Environnement de l'app PHP (development affiche les erreurs, à éviter
# en dehors d'un poste de dev) ---
APP_ENV=production

# --- Analyse IA (facultatif : laisser vide désactive juste ces
# fonctionnalités, voir class/AnthropicClient.php / GeminiClient.php) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Frontend : URL de base de l'API telle qu'appelée depuis le navigateur.
# "/api" (par défaut) passe par le reverse proxy nginx du frontend vers le
# conteneur backend (voir Frontend/admin-web/nginx.conf) : pas de CORS à
# gérer, fonctionne quel que soit le nom de domaine/IP utilisé pour accéder
# au frontend. Ne change cette valeur que si le backend doit être appelé
# directement sur une autre origine — nécessite alors de reconstruire
# l'image frontend (ARG de build Vite, voir Frontend/admin-web/Dockerfile).
VITE_API_BASE_URL=/api

# --- Ports publiés sur la machine hôte ---
FRONTEND_PUBLISHED_PORT=8080
BACKEND_PUBLISHED_PORT=8081
DB_PUBLISHED_PORT=3307
